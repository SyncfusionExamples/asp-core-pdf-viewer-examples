@page "{handler?}"
@model IndexModel
@{
    ViewData["Title"] = "Home page";
    var blankPdfUrl = string.Format("{0}://{1}/blank.pdf", HttpContext.Request.Scheme, HttpContext.Request.Host);
}

<div class="toolbar-actions">
    <div class="action-group">
        <h4>Set annotation mode for newly added annotations</h4>
        <button onclick="enableRectangleMode()">Rectangle</button>
        <button onclick="enableCircleMode()">Circle</button>
        <button onclick="enablePolygonMode()">Polygon</button>
        <button onclick="enableFreeTextMode()">Free Text</button>
        <button onclick="enableAreaMode()">Area</button>
        <button onclick="enableLineMode()">Line</button>
    </div>

    <div class="action-group">
        <h4>Exit annotation mode</h4>
        <button onclick="exitAnnotationMode()">Exit Annotation Mode</button>
    </div>

    <div class="action-group">
        <h4>Add annotations programmatically</h4>
        <button onclick="addCloudRectangle()">Cloud Rectangle</button>
        <button onclick="addDashedCircle()">Dashed Circle</button>
        <button onclick="addCloudFreeText()">Cloud Free Text</button>
        <button onclick="addDashedLine()">Dashed Line</button>
        <button onclick="addCloudArea()">Cloud Area</button>
        <button onclick="addDashedRadius()">Dashed Radius</button>
    </div>

    <div class="action-group">
        <h4>Modify existing annotation border</h4>
        <button onclick="applyCloudBorderToSelected()">Apply Cloud Border</button>
        <button onclick="applyDashedBorderToSelected()">Apply Dashed Border</button>
        <button onclick="resetBorderOfSelected()">Reset To Solid</button>
    </div>
</div>

<div style="width:100%;height:650px">
    <!-- To configure the server-backed PDF Viewer, include the "serviceUrl='/Index'" attribute -->
    <ejs-pdfviewer id="pdfviewer"
                   documentPath="@blankPdfUrl"
                   resourceUrl="https://cdn.syncfusion.com/ej2/31.2.2/dist/ej2-pdfviewer-lib"
                   documentLoad="documentLoaded">
    </ejs-pdfviewer>
</div>

<script type="text/javascript">
    // Apply the annotation settings once the document is loaded so that newly added
    // annotations and programmatic ones use the configured border styles.
    function documentLoaded() {
        var viewer = document.getElementById('pdfviewer').ej2_instances[0];

        viewer.rectangleSettings = {
            strokeColor: '#d32f2f',
            fillColor: '#ffe0b2',
            borderStyle: 'Cloud',
            cloudIntensity: 2
        };
        viewer.circleSettings = {
            strokeColor: '#1976d2',
            fillColor: '#bbdefb',
            borderStyle: 'Dashed',
            borderDashArray: [5, 5]
        };
        viewer.freeTextSettings = {
            fillColor: 'red',
            borderColor: '#2e7d32',
            fontColor: '#1b5e20',
            opacity: 0.3,
            enableAutoFit: true,
            borderStyle: 'Cloud',
            cloudIntensity: 2
        };
        viewer.lineSettings = {
            strokeColor: '#f57c00',
            borderStyle: 'Dashed',
            borderDashArray: [4, 3]
        };
        viewer.polygonSettings = {
            fillColor: '#ffa5d8',
            strokeColor: '#ff6a00',
            thickness: 2,
            opacity: 0.9,
            borderStyle: 'Cloud',
            cloudIntensity: 2
        };
        viewer.areaSettings = {
            fillColor: 'yellow',
            strokeColor: 'orange',
            opacity: 0.6,
            borderStyle: 'Cloud',
            cloudIntensity: 2
        };
    }

    function getViewer() {
        return document.getElementById('pdfviewer').ej2_instances[0];
    }

    // --- Set the mode used for newly added annotations ---

    function enableRectangleMode() {
        getViewer().annotation.setAnnotationMode('Rectangle');
    }

    function enableCircleMode() {
        getViewer().annotation.setAnnotationMode('Circle');
    }

    function enablePolygonMode() {
        getViewer().annotation.setAnnotationMode('Polygon');
    }

    function enableFreeTextMode() {
        getViewer().annotation.setAnnotationMode('FreeText');
    }

    function enableAreaMode() {
        getViewer().annotation.setAnnotationMode('Area');
    }

    function enableLineMode() {
        getViewer().annotation.setAnnotationMode('Line');
    }

    // --- Exit the annotation mode ---

    function exitAnnotationMode() {
        getViewer().annotation.setAnnotationMode('None');
    }

    // --- Add annotations programmatically with cloud/dashed borders ---

    function addCloudRectangle() {
        getViewer().annotation.addAnnotation('Rectangle', {
            offset: { x: 90, y: 120 },
            pageNumber: 1,
            width: 220,
            height: 110,
            borderStyle: 'Cloud',
            cloudIntensity: 2,
            strokeColor: '#d32f2f',
            fillColor: '#ffe0b2',
            opacity: 0.4,
            author: 'Guest'
        });
    }

    function addDashedCircle() {
        getViewer().annotation.addAnnotation('Circle', {
            offset: { x: 360, y: 120 },
            pageNumber: 1,
            width: 140,
            height: 140,
            borderStyle: 'Dashed',
            borderDashArray: [5, 5],
            strokeColor: '#1976d2',
            fillColor: '#bbdefb',
            opacity: 0.4,
            author: 'Guest'
        });
    }

    function addCloudFreeText() {
        getViewer().annotation.addAnnotation('FreeText', {
            offset: { x: 90, y: 300 },
            pageNumber: 1,
            width: 220,
            height: 70,
            borderStyle: 'Cloud',
            cloudIntensity: 1,
            borderColor: '#2e7d32',
            fillColor: '#e8f5e9',
            fontColor: '#1b5e20',
            opacity: 0.3,
            author: 'Guest'
        });
    }

    function addDashedLine() {
        getViewer().annotation.addAnnotation('Line', {
            offset: { x: 360, y: 330 },
            pageNumber: 1,
            points: [{ x: 360, y: 330 }, { x: 500, y: 400 }],
            borderStyle: 'Dashed',
            borderDashArray: [4, 3],
            strokeColor: '#f57c00',
            opacity: 1,
            author: 'Guest'
        });
    }

    function addCloudArea() {
        getViewer().annotation.addAnnotation('Area', {
            offset: { x: 90, y: 430 },
            pageNumber: 1,
            vertexPoints: [
                { x: 90, y: 430 },
                { x: 300, y: 430 },
                { x: 300, y: 520 },
                { x: 90, y: 520 }
            ],
            borderStyle: 'Cloud',
            cloudIntensity: 2,
            strokeColor: '#c2185b',
            fillColor: '#fce4ec',
            opacity: 0.4,
            author: 'Guest'
        });
    }

    function addDashedRadius() {
        getViewer().annotation.addAnnotation('Radius', {
            offset: { x: 380, y: 470 },
            pageNumber: 1,
            points: [{ x: 380, y: 470 }, { x: 470, y: 470 }],
            borderStyle: 'Dashed',
            borderDashArray: [6, 3],
            strokeColor: '#00838f',
            opacity: 1,
            author: 'Guest'
        });
    }

    // --- Modify the border style of the currently selected annotation ---
    function updateSelectedBorder(borderStyle, extra) {
        var viewer = getViewer();
        var annotation =
            viewer.annotationCollection[viewer.annotationCollection.length - 1];

        if (!annotation) {
            return;
        }

        // Set border style
        annotation.borderStyle = borderStyle;

        // Apply additional properties dynamically
        Object.keys(extra || {}).forEach(function (key) {
            annotation[key] = extra[key];
        });

        viewer.annotation.editAnnotation(annotation);
    }

    function applyCloudBorderToSelected() {
        updateSelectedBorder('Cloud', {
            cloudIntensity: 2
        });
    }

    function applyDashedBorderToSelected() {
        updateSelectedBorder('Dashed', {
            borderDashArray: [5, 5]
        });
    }

    function resetBorderOfSelected() {
        updateSelectedBorder('Solid', {
            borderDashArray: null,
            cloudIntensity: 1
        });
    }
</script>

<style>
    .toolbar-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 16px;
        margin-bottom: 8px;
    }

    .toolbar-actions .action-group {
        border: 1px solid #ddd;
        padding: 8px 12px;
        border-radius: 4px;
    }

    .toolbar-actions h4 {
        margin: 0 0 8px;
        font-size: 14px;
    }

    .toolbar-actions button {
        margin-right: 4px;
        margin-bottom: 4px;
    }
</style>