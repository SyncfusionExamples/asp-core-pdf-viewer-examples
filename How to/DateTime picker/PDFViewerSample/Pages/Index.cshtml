@page "{handler?}"
@model IndexModel
@{
    ViewData["Title"] = "Home page";
}

<div class="control-section" style="margin-bottom: 8px;">
    <button onclick="addDateField()">Add Date Picker</button>
    <button onclick="addTimeField()">Add Time Picker</button>
</div>

<div style="width:100%;height:680px">
    <!-- To configure the server-backed PDF Viewer, include the "serviceUrl='/Index'" attribute -->
    <ejs-pdfviewer id="pdfviewer"
                   documentPath="https://cdn.syncfusion.com/content/pdf/form-filling-document.pdf"
                   resourceUrl="https://cdn.syncfusion.com/ej2/31.2.2/dist/ej2-pdfviewer-lib">
    </ejs-pdfviewer>
</div>

<script type="text/javascript">
    function getViewer() {
        return document.getElementById('pdfviewer').ej2_instances[0];
    }

    // Add a Date Picker form field programmatically
    function addDateField() {
        getViewer().formDesignerModule.addFormField('Textbox', {
            name: 'DateField1',
            bounds: { X: 146, Y: 200, Width: 200, Height: 24 },
            pageNumber: 1,
            isDateField: true,
            fontSize: 10,
            color: 'black',
            fontFamily: 'Helvetica',
            backgroundColor: '#daeaf7ff',
            borderColor: '#303030',
            alignment: 'Left',
            isReadOnly: false,
            visibility: 'visible',
            isRequired: false,
            isPrint: true,
            tooltip: '',
            thickness: 1,
            actions: {
                format: { script: 'AFDate_FormatEx("m/d/yy")' }
            }
        });
    }

    // Add a Time Picker form field programmatically
    function addTimeField() {
        getViewer().formDesignerModule.addFormField('Textbox', {
            name: 'TimeField1',
            bounds: { X: 146, Y: 250, Width: 200, Height: 24 },
            pageNumber: 1,
            isDateField: true,
            fontSize: 10,
            color: 'black',
            fontFamily: 'Helvetica',
            backgroundColor: '#daeaf7ff',
            borderColor: '#303030',
            alignment: 'Left',
            isReadOnly: false,
            visibility: 'visible',
            isRequired: false,
            isPrint: true,
            tooltip: '',
            thickness: 1,
            actions: {
                format: { script: 'AFTime_FormatEx("HH:MM")' }
            }
        });
    }
</script>